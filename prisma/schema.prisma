// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma Client (app + `prisma db seed`) reads this — use a reachable URL locally (see .env.example).
  url       = env("DATABASE_URL")
  // `prisma migrate deploy` / `migrate dev` use this when set (migrations bypass the pooler when configured).
  directUrl = env("DIRECT_URL")
}

model Store {
  id          Int      @id @default(autoincrement())
  storeNumber String   @unique
  name        String
  sortOrder   Int      @default(0)
  orders      Order[]
}

model Vendor {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id              Int         @id @default(autoincrement())
  name            String
  category        String
  unitPriceCents  Int
  sortOrder       Int         @default(0)
  maxQuantity     Int          @default(5)
  totalInStock    Int          @default(100)
  isActive        Boolean     @default(true)
  isUniform       Boolean     @default(false)
  availableSizes  String?     // JSON array: ["XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL"]
  availableColors String?     // JSON array: ["Navy Blue", "Royal Blue", "White", etc.]
  style           String?      // "Men", "Women", "Unisex", or null
  sizePriceMap    String?     // JSON object: {"XS": 1600, "S": 1600, "XXL": 1800, ...} in cents
  vendorId        Int
  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  orderLines      OrderLine[]
}

enum OrderFlagColor {
  RED
  GREEN
  ORANGE
}

model Order {
  id            Int             @id @default(autoincrement())
  storeId      Int
  store         Store           @relation(fields: [storeId], references: [id])
  managerName  String
  createdAt    DateTime        @default(now())
  orderDate    DateTime        @default(now())
  subtotalCents Int
  notes        String?
  orderType    String?          // 'NSSO', 'SU', 'ADC_S', 'ADC_M', 'HM'
  flagColor    OrderFlagColor?
  orderLines   OrderLine[]
}

model DailyAnnouncement {
  id        Int      @id @default(1)
  title     String
  body      String   @db.Text
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model OrderLine {
  id                    Int     @id @default(autoincrement())
  orderId               Int
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             Int
  product               Product @relation(fields: [productId], references: [id])
  productNameSnapshot   String
  unitPriceCentsSnapshot Int
  currentQuantity       Int     @default(0)
  orderQuantity         Int
  lineTotalCents        Int
  size                  String? // For uniforms: "XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL"
  color                 String? // For uniforms: "Navy Blue", "Royal Blue", "White", etc.
  style                 String? // For uniforms: "Men", "Women", "Unisex"
}
